{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "tools/loc-budget.ts",
        "tools/prof-sweep.ts",
        "tools/ast-ccn.ts",
        "ops/**/*.{ts,tsx}",
        "src/fulltags/cli.ts",
        "src/fulltags/test/*.test.ts",
        "src/fulltags/test/fake-echo-worker.ts",
        "src/fulltags/test/idle-worker.ts",
        "src/fulltags/test/stamp.ts",
        "src/fulltags/test/patchCases.ts",
        "src/fulltags/test/analysis.ts"
      ],
      "ignoreExportsUsedInFile": true,
      "ignoreBinaries": [
        "ditto",
        "ffprobe",
        "yt-dlp",
        "plutil",
        "wait",
        "ffmpeg",
        "pgrep",
        "uv",
        "jscpd"
      ],
      "ignoreDependencies": ["preact"]
    },
    "cratedeck": {
      "entry": [
        "src/deckctl.ts",
        "src/mcp.ts",
        "src/*.test.ts",
        "test/*.test.ts",
        "test/testutil.ts",
        "shared/types.ts"
      ],
      "ignoreExportsUsedInFile": true
    },
    "cratedeck/web": {
      "ignoreExportsUsedInFile": true
    }
  }
}
