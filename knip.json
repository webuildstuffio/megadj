{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "tools/fetch-all.ts",
        "tools/fix-years.ts",
        "tools/prof-sweep.ts"
      ],
      "ignore": [".cursor/**"],
      "ignoreExportsUsedInFile": true,
      "ignoreBinaries": [
        "ditto",
        "ffprobe",
        "yt-dlp",
        "plutil",
        "wait",
        "md5",
        "ffmpeg",
        "pgrep",
        "uv"
      ],
      "ignoreDependencies": ["preact"]
    },
    "fulltags": {
      "entry": [
        "src/index-all.ts",
        "verify-key.ts",
        "test/*.test.ts",
        "test/helpers/*.ts"
      ],
      "ignoreBinaries": ["ffmpeg"],
      "ignoreExportsUsedInFile": true
    },
    "cratedeck": {
      "entry": [
        "src/deckctl.ts",
        "src/bench.ts",
        "src/mcp.ts",
        "test/*.test.ts",
        "shared/types.ts"
      ],
      "ignoreExportsUsedInFile": true
    },
    "cratedeck/web": {
      "ignoreExportsUsedInFile": true
    }
  }
}
