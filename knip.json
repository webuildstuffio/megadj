{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "src/deck/**/*.{test.ts,test.tsx}",
        "src/deck/test/testutil.ts",
        "src/deck/web/app/main.tsx",
        "src/deck/web/vite.config.ts",
        "src/fulltags/cli/cli.ts",
        "src/fulltags/test/*.test.ts",
        "src/fulltags/test/analysis.ts",
        "src/fulltags/test/fake-echo-worker.ts",
        "src/fulltags/test/idle-worker.ts",
        "src/fulltags/test/patchCases.ts",
        "src/fulltags/test/stamp.ts",
        "src/ops/**/*.{ts,tsx}",
        "tools/ast-ccn.ts",
        "tools/loc-budget.ts",
        "tools/prof-sweep.ts"
      ],
      "ignoreExportsUsedInFile": true,
      "ignoreBinaries": [
        "ditto",
        "ffprobe",
        "yt-dlp",
        "plutil",
        "wait",
        "ffmpeg",
        "pgrep",
        "uv",
        "jscpd"
      ],
      "ignoreDependencies": [
        "@preact/preset-vite",
        "@tanstack/preact-table",
        "fuse.js",
        "lucide-preact",
        "preact",
        "preact-render-to-string",
        "tinykeys",
        "vite"
      ]
    }
  }
}
