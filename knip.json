{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": ["tools/loc-budget.ts", "tools/prof-sweep.ts"],
      "ignoreExportsUsedInFile": true,
      "ignoreBinaries": [
        "ditto",
        "ffprobe",
        "yt-dlp",
        "plutil",
        "wait",
        "ffmpeg",
        "pgrep",
        "uv"
      ],
      "ignoreDependencies": ["preact"]
    },
    "fulltags": {
      "entry": [
        "src/index-all.ts",
        "src/fetch-pipeline.ts",
        "src/verify-key.ts",
        "test/*.test.ts",
        "test/helpers/*.ts",
        "test/fixtures/*.ts"
      ],
      "ignoreBinaries": ["ffmpeg"],
      "ignoreExportsUsedInFile": true
    },
    "cratedeck": {
      "entry": [
        "src/deckctl.ts",
        "src/mcp.ts",
        "test/*.test.ts",
        "shared/types.ts"
      ],
      "ignoreExportsUsedInFile": true
    },
    "cratedeck/web": {
      "ignoreExportsUsedInFile": true
    }
  }
}
