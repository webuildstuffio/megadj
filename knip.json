{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "tools/fetch_all.ts",
        "tools/fix_years.ts",
        "tools/prof_sweep.ts"
      ],
      "ignore": [
        "fulltags/**"
      ],
      "ignoreExportsUsedInFile": true,
      "ignoreBinaries": [
        "ditto",
        "ffprobe",
        "yt-dlp",
        "plutil",
        "wait",
        "md5",
        "fpcalc",
        "pgrep",
        "uv"
      ],
      "ignoreDependencies": [
        "preact"
      ]
    },
    "cratedeck": {
      "entry": [
        "src/deckctl.ts",
        "src/bench.ts",
        "src/mcp.ts",
        "test/*.test.ts",
        "shared/types.ts"
      ],
      "ignoreExportsUsedInFile": true
    },
    "cratedeck/web": {
      "ignoreExportsUsedInFile": true
    }
  }
}
