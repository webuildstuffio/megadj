{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": ["tools/fetch_all.ts", "tools/fix_years.ts"],
      "ignore": ["fulltags/**"],
      "ignoreExportsUsedInFile": true,
      "ignoreBinaries": [
        "oxlint",
        "ditto",
        "ffmpeg",
        "uv",
        "ffprobe",
        "yt-dlp",
        "plutil"
      ],
      "ignoreDependencies": ["preact"]
    },
    "cratedeck": {
      "entry": [
        "src/deckctl.ts",
        "src/bench.ts",
        "shared/types.ts",
        "test/*.test.ts"
      ],
      "ignoreExportsUsedInFile": true
    },
    "cratedeck/web": {
      "ignoreExportsUsedInFile": true
    }
  }
}
