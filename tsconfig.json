{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "types": ["bun"]
  },
  "include": [
    "src/**/*.ts",
    "fulltags/**/*.ts",
    "cratedeck/src/**/*.ts",
    "cratedeck/shared/**/*.ts",
    "cratedeck/web/**/*.ts",
    "cratedeck/web/**/*.tsx",
    "cratedeck/test/**/*.ts",
    "tools/**/*.ts"
  ]
}
